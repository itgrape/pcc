# PCC 配置中心 — 开发环境

# ---- Casdoor OAuth 配置 ----
VITE_CASDOOR_URL=
VITE_CASDOOR_CLIENT_ID=
VITE_CASDOOR_APP_NAME=app-pcc
VITE_CASDOOR_ORG=built-in

# ---- API 后端代理 ----
# Vite dev server 将 /api 请求代理到此地址
# 修改此项以指向不同的后端地址
VITE_API_PROXY_TARGET=http://localhost:8080

# 生产环境统一镜像走同源 API，通常留空。
VITE_API_BASE_URL=
