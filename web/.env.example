# PCC 配置中心 — 开发环境

# ---- Casdoor OAuth 配置 ----
# Casdoor 服务地址
VITE_CASDOOR_URL=
# Casdoor 应用的 Client ID
VITE_CASDOOR_CLIENT_ID=
# Casdoor 应用名称
VITE_CASDOOR_APP_NAME=
# Casdoor 组织名称
VITE_CASDOOR_ORG=

# ---- API 后端代理 ----
# Vite dev server 将 /api 请求代理到此地址
# 修改此项以指向不同的后端地址
VITE_API_PROXY_TARGET=http://localhost:8080

# ---- API 基础路径 ----
# 生产环境可改为完整后端 URL（不再走代理），开发环境走 proxy 所以留空
VITE_API_BASE_URL=
