# PCC 配置中心后端。所有变量以 PCC_ 前缀。
# 优先从真实环境变量读取，不存在时回退到 .env 文件。

# ---- HTTP 服务 ----
# 管理端：前端页面、登录和 /api/v1/admin/*。
PCC_ADMIN_ADDR=:8080
# 服务端：仅提供 /api/v1/runtime/*，生产环境不要配置域名反向代理。
PCC_RUNTIME_ADDR=:8081

# ---- 数据库（MariaDB）----
# DSN 格式：user:pass@tcp(host:3306)/pcc?charset=utf8mb4&parseTime=true&loc=Local
PCC_DB_DSN=
PCC_DB_MAX_OPEN_CONNS=50
PCC_DB_MAX_IDLE_CONNS=10
PCC_DB_CONN_MAX_LIFETIME=1h

# ---- 单管理员账号 ----
PCC_ADMIN_USERNAME=
PCC_ADMIN_PASSWORD=
# 本地 HTTP 开发时可设为 false；生产 HTTPS 保持 true。
PCC_COOKIE_SECURE=false

# ---- 雪花 ID 节点号 [0,1023]，多实例需互不相同 ----
PCC_SNOWFLAKE_NODE_ID=1
